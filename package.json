{
  "name": "domy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @domy/server --filter @domy/web dev",
    "build": "pnpm --recursive build",
    "check": "prettier --check . && eslint . --max-warnings 0 && tsc --noEmit && pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "test:e2e": "pnpm --filter @domy/web test:e2e",
    "db:generate": "pnpm --filter @domy/server db:generate",
    "db:migrate": "pnpm --filter @domy/server db:migrate",
    "db:seed": "pnpm --filter @domy/server db:seed",
    "tokens": "node scripts/generate-design-tokens.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@material/material-color-utilities": "0.3.0",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
