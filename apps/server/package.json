{
  "name": "@domy/server",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/db/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@domy/domain": "workspace:*",
    "@hono/node-server": "2.1.3",
    "@hono/zod-validator": "0.9.1",
    "@sentry/node": "11.1.0",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "resend": "6.31.0",
    "web-push": "3.6.7",
    "write-excel-file": "4.1.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "read-excel-file": "9.3.10",
    "testcontainers": "12.2.0",
    "vitest": "5.0.3"
  }
}
