# Local PostgreSQL started by compose.yaml (development only)
POSTGRES_USER=domy
POSTGRES_PASSWORD=domy
POSTGRES_DB=domy
# PostgreSQL connection string
DATABASE_URL=postgres://domy:domy@localhost:5432/domy
# Secret used by Better Auth to sign sessions; at least 32 characters
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public address of the app, used in emails and auth callbacks
APP_URL=http://localhost:5173
# Port of the API server (the web app proxies /api to it in development)
API_PORT=3000
# Resend API key for transactional email; without it, emails are written to the log
RESEND_API_KEY=
# Sender address for transactional email
EMAIL_FROM=Domy <no-reply@example.com>
# Sentry DSN for server error reporting; optional
SENTRY_DSN=
# Sentry DSN for browser error reporting (read when the web app is built); optional
VITE_SENTRY_DSN=
# Fixed "now" for development and tests only (ISO 8601); ignored in production
DOMY_FAKE_NOW=
# Photo storage with the S3 API (feature 003). Leave them empty in development to use the S3Proxy
# of compose.yaml (http://localhost:9100); production names its bucket (DigitalOcean Spaces)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for path-style addresses (S3Proxy); false for DigitalOcean Spaces
S3_FORCE_PATH_STYLE=
# Phone notifications (Web Push). Generate a pair with `pnpm dlx web-push generate-vapid-keys`;
# set the three (VAPID_SUBJECT as mailto:…) or none (no notifications in development); required in production
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
